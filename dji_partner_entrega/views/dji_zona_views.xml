<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista lista de zonas -->
    <record id="view_dji_zona_list" model="ir.ui.view">
        <field name="name">dji.zona.list</field>
        <field name="model">dji.zona</field>
        <field name="arch" type="xml">
            <list string="Zonas de reparto" editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario de zona -->
    <record id="view_dji_zona_form" model="ir.ui.view">
        <field name="name">dji.zona.form</field>
        <field name="model">dji.zona</field>
        <field name="arch" type="xml">
            <form string="Zona de reparto">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_dji_zona" model="ir.actions.act_window">
        <field name="name">Zonas de reparto</field>
        <field name="res_model">dji.zona</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menú: Ventas > Configuración > Zonas de reparto DJI -->
    <menuitem id="menu_dji_zona"
              name="Zonas de reparto DJI"
              parent="sale.sale_order_menu_root"
              action="action_dji_zona"
              sequence="99"
              groups="sales_team.group_sale_manager"/>

</odoo>
