<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pestaña "Catálogo" en la ficha del artículo -->
    <record id="product_template_form_catalogo" model="ir.ui.view">
        <field name="name">product.template.form.catalogo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Catálogo" name="catalogo">
                    <group>
                        <group string="Catálogo a medida">
                            <field name="ficha_tecnica" filename="ficha_tecnica_nombre"/>
                            <field name="ficha_tecnica_nombre" invisible="1"/>
                        </group>
                        <group string="Foto">
                            <div colspan="2" class="d-flex gap-2">
                                <button name="action_foto_fondo_blanco" type="object" string="Fondo blanco"
                                        icon="fa-magic" class="btn-secondary" invisible="not image_1920"
                                        help="Fondo blanco, producto recortado y centrado, 1200×1200 (Photoroom)"/>
                                <button name="action_foto_restaurar" type="object" string="Volver a la original"
                                        icon="fa-undo" class="btn-link" invisible="not imagen_original"/>
                            </div>
                            <field name="imagen_original" widget="image" options="{'size': [90, 90]}"
                                   invisible="not imagen_original" readonly="1"/>
                        </group>
                        <group string="Etiquetas de catálogo" colspan="2">
                            <field name="tags_producto" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'dji_grupo_codigo': 'producto'}" placeholder="Hamburguesas, Croquetas, Canelones…"/>
                            <field name="tags_momento" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'dji_grupo_codigo': 'momento'}"/>
                            <field name="tags_origen" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'dji_grupo_codigo': 'origen'}"/>
                            <field name="tags_preparacion" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'dji_grupo_codigo': 'preparacion'}"/>
                            <field name="tags_conservacion" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'dji_grupo_codigo': 'conservacion'}"/>
                            <field name="tags_alergenos" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'dji_grupo_codigo': 'alergenos'}"/>
                            <field name="tags_caracteristicas" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'dji_grupo_codigo': 'caracteristicas'}"/>
                            <field name="tags_calidad" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'dji_grupo_codigo': 'calidad'}"/>
                            <field name="tags_otras" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" context="{'dji_grupo_codigo': 'otras'}"/>
                        </group>
                        <group string="Revisión">
                            <field name="catalogo_revisado" widget="boolean_toggle"/>
                            <field name="catalogo_revisado_fecha" invisible="not catalogo_revisado"/>
                            <field name="catalogo_revisado_uid" invisible="not catalogo_revisado"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Búsqueda: filtros de revisión -->
    <record id="product_template_search_catalogo" model="ir.ui.view">
        <field name="name">product.template.search.catalogo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="catalogo_pendiente" string="Pendientes de revisar (catálogo)"
                        domain="[('catalogo_revisado', '=', False)]"/>
                <filter name="catalogo_ok" string="Revisados para catálogo"
                        domain="[('catalogo_revisado', '=', True)]"/>
                <filter name="sin_foto" string="Sin foto" domain="[('image_1920', '=', False)]"/>
                <filter name="sin_ficha" string="Sin ficha técnica" domain="[('ficha_tecnica', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_list_catalogo" model="ir.ui.view">
        <field name="name">product.template.list.catalogo</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Artículos · catálogo">
                <field name="image_128" widget="image" options="{'size': [40, 40]}"/>
                <field name="default_code"/>
                <field name="name"/>
                <field name="categ_id" optional="show"/>
                <field name="product_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="ficha_tecnica_nombre" string="Ficha técnica" optional="show"/>
                <field name="catalogo_revisado"/>
                <field name="catalogo_revisado_fecha" optional="show"/>
                <field name="catalogo_revisado_uid" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_catalogo_pendientes" model="ir.actions.act_window">
        <field name="name">Artículos · catálogo</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="product_template_list_catalogo"/>
        <field name="context">{'search_default_catalogo_pendiente': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay artículos pendientes de revisar</p>
            <p>Los artículos se completan desde la recepción de mercancía, con el botón "Completar artículos".</p>
        </field>
    </record>
</odoo>
