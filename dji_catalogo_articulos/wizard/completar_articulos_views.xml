<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catalogo_completar_form" model="ir.ui.view">
        <field name="name">dji.catalogo.completar.form</field>
        <field name="model">dji.catalogo.completar</field>
        <field name="arch" type="xml">
            <form string="Completar artículos">
                <div class="text-muted mb-2">
                    Pulsa en un artículo para poner foto, etiquetas, unidades y ficha técnica.
                    Marca <b>Revisado</b> cuando esté comprobado con la mercancía delante:
                    solo los revisados salen en los catálogos de Copiloto.
                </div>
                <field name="tiene_uds" invisible="1"/>
                <field name="linea_ids" nolabel="1">
                    <list create="0" delete="0" decoration-muted="ya_revisado">
                        <field name="imagen" widget="image" options="{'size': [48, 48]}"/>
                        <field name="referencia"/>
                        <field name="nombre"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="uds_defecto" string="Uds." column_invisible="not parent.tiene_uds"/>
                        <field name="ficha_nombre" string="Ficha"/>
                        <field name="ya_revisado" column_invisible="1"/>
                        <field name="tiene_uds" column_invisible="1"/>
                        <field name="imagen_original" column_invisible="1"/>
                        <button name="action_fondo_blanco" type="object" string="Fondo blanco"
                                icon="fa-magic" class="btn-link" invisible="not imagen"
                                title="Fondo blanco, recortado y centrado (Photoroom)"/>
                        <button name="action_restaurar_foto" type="object" icon="fa-undo" class="btn-link"
                                invisible="not imagen_original" title="Volver a la foto original"/>
                        <field name="revisado" widget="boolean_toggle"/>
                    </list>
                    <form string="Artículo">
                        <field name="ya_revisado" invisible="1"/>
                        <field name="tiene_uds" invisible="1"/>
                        <div class="alert alert-info" role="alert" invisible="not ya_revisado">
                            Este artículo ya estaba revisado. Puedes corregir lo que haga falta.
                        </div>
                        <label for="nombre"/>
                        <field name="nombre" class="w-100 fs-5 mb-3"/>
                        <group>
                            <group>
                                <field name="product_tmpl_id"/>
                                <field name="referencia"/>
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color', 'no_create_edit': True}"
                                       placeholder="Escribe para buscar o crear (ej. Sin gluten)"/>
                                <field name="uds_defecto" invisible="not tiene_uds"/>
                                <field name="ficha" filename="ficha_nombre"/>
                                <field name="ficha_nombre" invisible="1"/>
                                <field name="revisado" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="imagen" widget="image" options="{'size': [300, 300]}"/>
                            </group>
                        </group>
                    </form>
                </field>
                <footer>
                    <button name="action_guardar" type="object" string="Guardar" class="btn-primary" data-hotkey="s"/>
                    <button name="action_marcar_todos" type="object" string="Marcar todos como revisados" class="btn-secondary"/>
                    <button special="cancel" string="Cancelar" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
