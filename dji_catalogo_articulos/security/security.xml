<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Aparece en la ficha del usuario (Ajustes → Usuarios) como
         "Catálogo de artículos: Gestor". Solo quien tenga este permiso ve el
         botón "Completar artículos" y puede crear etiquetas nuevas. -->
    <record id="res_groups_privilege_catalogo" model="res.groups.privilege">
        <field name="name">Catálogo de artículos</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_catalogo_gestor" model="res.groups">
        <field name="name">Gestor</field>
        <field name="privilege_id" ref="res_groups_privilege_catalogo"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
