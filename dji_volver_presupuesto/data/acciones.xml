<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú Acción de la lista de pedidos (varios a la vez) -->
    <record id="accion_volver_presupuesto_ventas" model="ir.actions.server">
        <field name="name">Volver a presupuesto</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_dji_volver_presupuesto()</field>
    </record>
</odoo>
