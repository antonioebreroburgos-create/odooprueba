<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Las acciones de serie se mantienen (mismo nombre técnico, así no se
         rompe nada que pida el PDF por su nombre, como Copiloto); solo se les
         pone el formato de papel de DJI. El diseño se elige en las plantillas. -->
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="dji_albaran.paperformat_albaran_dji"/>
    </record>
    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="paperformat_id" ref="dji_albaran.paperformat_albaran_dji"/>
    </record>
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="dji_albaran.paperformat_albaran_dji"/>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Presupuesto %s - %s' or 'Pedido %s - %s') % (object.name.replace('/', '_'), object.partner_id.commercial_partner_id.name or '')</field>
    </record>
</odoo>
