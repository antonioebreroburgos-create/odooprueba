<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dji_faltas_wizard_view_form" model="ir.ui.view">
        <field name="name">dji.faltas.wizard.form</field>
        <field name="model">dji.faltas.wizard</field>
        <field name="arch" type="xml">
            <form string="Gestionar faltas">
                <field name="order_id" invisible="1" force_save="1"/>
                <p>
                    Indica la cantidad en falta de cada producto. La cantidad
                    "Disponible" es solo orientativa (stock de Odoo); si el
                    almacén sabe que en realidad no hay, corrige la falta a mano.
                </p>
                <field name="line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="order_line_id" column_invisible="1" force_save="1"/>
                        <field name="product_id" column_invisible="1" force_save="1"/>
                        <field name="descripcion" readonly="1" force_save="1"/>
                        <field name="qty_pedida" readonly="1" force_save="1"/>
                        <field name="qty_disponible" readonly="1" force_save="1"/>
                        <field name="qty_falta" force_save="1"/>
                    </list>
                </field>
                <footer>
                    <button
                        name="action_confirmar"
                        string="Confirmar faltas"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="dji_faltas_wizard_action" model="ir.actions.act_window">
        <field name="name">Gestionar faltas</field>
        <field name="res_model">dji.faltas.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
