<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_dji_gestion_faltas" model="ir.ui.view">
        <field name="name">sale.order.form.dji.gestion.faltas</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_abrir_gestion_faltas"
                        type="object"
                        string="Gestionar faltas"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>
</odoo>
